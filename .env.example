# === Database ===
# Required. PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://faultloc:faultloc@db:5432/faultloc
DATABASE_URL_SYNC=postgresql://faultloc:faultloc@db:5432/faultloc
POSTGRES_USER=faultloc
POSTGRES_PASSWORD=faultloc
POSTGRES_DB=faultloc

# === Application ===
# Optional. Defaults shown.
APP_HOST=0.0.0.0
APP_PORT=8000
CONFIRMATION_WINDOW_SECONDS=60
CORROBORATION_THRESHOLD=3
CORROBORATION_WINDOW_SECONDS=30
SWEEP_INTERVAL_SECONDS=10
GRACE_PERIOD_MINUTES=30

# === AI Feature (Explain This Ticket) ===
# Optional. If not set, AI explanations fall back to structured data display.
OPENAI_API_KEY=
# Optional. Model to use for explanations. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# === Frontend ===
VITE_API_URL=http://localhost:8000
